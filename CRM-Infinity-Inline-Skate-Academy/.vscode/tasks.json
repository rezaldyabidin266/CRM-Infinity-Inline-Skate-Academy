{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Java App",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "build.bat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run Java App",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "run.bat"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
