{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run REST API",
      "type": "shell",
      "command": "mvn",
      "args": ["spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Package REST API",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "package"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
